# ========================================================
# MOCHI: Your Pocket Companion — Firebase Configuration
# ========================================================
# Copy this file to .env and replace the placeholder values
# with your actual project keys from Firebase Console:
# https://console.firebase.google.com/
#
# IMPORTANT: Never commit .env to version control!
# ========================================================

VITE_FIREBASE_API_KEY=AIzaSyExampleKey_ReplaceWithYourActualKey
VITE_FIREBASE_AUTH_DOMAIN=mochi-virtual-pet.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://mochi-virtual-pet-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=mochi-virtual-pet
VITE_FIREBASE_STORAGE_BUCKET=mochi-virtual-pet.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

